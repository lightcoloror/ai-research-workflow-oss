  "description": "Local-first multi-source retrieval and optional atomic fact-checking backend.",
  "endpoints": {
    "agent_events": {
      "method": "GET",
      "path": "/v1/agent/jobs/{job_id}/events",
      "purpose": "Poll stable agent job events without using internal job endpoints."
    },
    "agent_fetch": {
      "method": "POST",
      "path": "/v1/agent/fetch",
      "purpose": "Stable async agent contract for URL fetch and evidence ingestion jobs."
    },
    "agent_job": {
      "method": "GET",
      "path": "/v1/agent/jobs/{job_id}",
      "purpose": "Poll stable agent job status and final result."
    },
    "agent_research": {
      "method": "POST",
      "path": "/v1/agent/research",
      "purpose": "Stable async agent contract for research jobs. Returns job_id and polling links."
    },
    "agent_retry": {
      "method": "POST",
      "path": "/v1/agent/jobs/{job_id}/retry",
      "purpose": "Retry a terminal agent job with optional payload overrides."
    },
    "agent_verify": {
      "method": "POST",
      "path": "/v1/agent/verify",
      "purpose": "Stable async agent contract for atomic verification jobs."
    },
    "audit": {
      "method": "GET",
      "path": "/api/audit?id=<run_id>",
      "purpose": "Re-check a persisted run."
    },
    "capabilities": {
      "method": "GET",
      "path": "/v1/capabilities",
      "purpose": "Discover modes, providers, formats, and feature flags."
    },
    "discovery": {
      "method": "GET",
      "path": "/v1/discovery",
      "purpose": "Discover recommended agent interfaces and evidence policy."
    },
    "doctor": {
      "method": "GET",
      "path": "/api/doctor",
      "purpose": "Check local configuration and runtime health."
    },
    "evidence": {
      "method": "POST",
      "path": "/api/evidence",
      "purpose": "Add a source-backed manual evidence note."
    },
    "health": {
      "method": "GET",
      "path": "/v1/health",
      "purpose": "Check service health and API version."
    },
    "obsidian": {
      "method": "POST",
      "path": "/api/obsidian",
      "purpose": "Export a saved run to Obsidian."
    },
    "openapi": {
      "method": "GET",
      "path": "/v1/openapi.json",
      "purpose": "Machine-readable OpenAPI contract."
    },
    "run": {
      "method": "POST",
      "path": "/api/run",
      "purpose": "Plan, retrieve, collect evidence, verify claims, persist report, and audit."
    },
    "runs": {
      "method": "GET",
      "path": "/api/runs?limit=20",
      "purpose": "List persisted runs."
    },
    "search": {
      "method": "POST",
      "path": "/api/search",
      "purpose": "Plan, retrieve, collect evidence snippets, persist a search-only report, and skip fact checking."
    },
    "selftest": {
      "method": "POST",
      "path": "/api/selftest",
      "purpose": "Run local end-to-end acceptance checks."
    },
    "v1_deepen": {
      "method": "POST",
      "path": "/v1/deepen",
      "purpose": "Stable agent-facing deepened search run."
    },
    "v1_deepen_claims": {
      "method": "POST",
      "path": "/v1/runs/{run_id}/deepen-claims",
      "purpose": "Generate next-search queries for partial, not_found, or high-risk weak claims."
    },
    "v1_events": {
      "method": "GET",
      "path": "/v1/runs/{run_id}/events",
      "purpose": "Fetch run events as JSON or SSE."
    },
    "v1_ingest": {
      "method": "POST",
      "path": "/v1/ingest",
      "purpose": "Stable agent-facing manual URL ingest."
    },
    "v1_quality": {
      "method": "POST",
      "path": "/v1/runs/{run_id}/quality",
      "purpose": "Summarize citation coverage, source diversity, and evidence strength."
    },
    "v1_references_check": {
      "method": "POST",
      "path": "/v1/references/check",
      "purpose": "Validate DOI/arXiv references from text or a persisted run."
    },
    "v1_report_json": {
      "method": "GET",
      "path": "/v1/runs/{run_id}/report.json",
      "purpose": "Fetch machine-readable report."
    },
    "v1_report_md": {
      "method": "GET",
      "path": "/v1/runs/{run_id}/report.md",
      "purpose": "Fetch Markdown report."
    },
    "v1_route": {
      "method": "POST",
      "path": "/v1/route",
      "purpose": "Plan adaptive provider routing without executing search."
    },
    "v1_run": {
      "method": "GET",
      "path": "/v1/runs/{run_id}",
      "purpose": "Fetch persisted run metadata."
    },
    "v1_search": {
      "method": "POST",
      "path": "/v1/search",
      "purpose": "Stable agent-facing search-only research run."
    },
    "v1_verify": {
      "method": "POST",
      "path": "/v1/verify",
      "purpose": "Stable agent-facing atomic verification."
    }
  },
  "name": "ai-research-workflow",
  "package_version": "0.1.0",
